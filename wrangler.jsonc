{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare account. OpenNext derives the
  // WORKER_SELF_REFERENCE service binding from this — a mismatch fails the
  // deploy with "references Worker ... which was not found" [code: 10143].
  "name": "devfest-2026",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  // Supabase das inscrições (lib/supabase.ts; OpenNext expõe em process.env).
  // A chave publishable é pública por design: as tabelas têm RLS fechado e ela
  // só executa `inscrever` e `situacao_atividade` (supabase/migrations).
  // NUNCA coloque aqui a secret / service_role key.
  "vars": {
    "SUPABASE_URL": "https://yqkfkarhhhcafuneweoa.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_hsqZTiUPRCUUQxULVG8l4w_is7Q1Cje"
  }
}
