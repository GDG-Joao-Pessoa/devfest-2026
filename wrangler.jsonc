{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare account. OpenNext derives the
  // WORKER_SELF_REFERENCE service binding from this — a mismatch fails the
  // deploy with "references Worker ... which was not found" [code: 10143].
  "name": "devfest-2026",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  }
}
